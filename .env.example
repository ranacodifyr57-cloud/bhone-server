# MongoDB connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/bhone-enterprises

# JWT secret key (change this to any random long string)
JWT_SECRET=bhone_enterprises_super_secret_key_change_this_2024

# Your email for sending contact form messages
